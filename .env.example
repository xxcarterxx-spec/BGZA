# Copy this file to .env for local testing (Render deployments set these as
# real environment variables in the dashboard instead — see README.md).

# Bot Token, from the Discord Developer Portal > your application > Bot
DISCORD_TOKEN=

# Application ID, from the Developer Portal > your application > General Information
CLIENT_ID=

# Optional: a single server's ID, for instant command registration while testing.
# Leave blank to register the /survivor command globally instead (slower to
# propagate — up to about an hour — but works in every server the bot joins).
GUILD_ID=

# Optional: where the local JSON "database" of saved characters is written.
# Defaults to ./data/characters.json if unset.
DB_PATH=

# Set automatically by Render — no need to set this yourself in production.
PORT=3000
